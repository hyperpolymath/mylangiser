package mylangiser-abi

sourcedir = "."

modules = Mylangiser.ABI.Types
        , Mylangiser.ABI.Layout
        , Mylangiser.ABI.Foreign
        , Mylangiser.ABI.Proofs
        , Mylangiser.ABI.Semantics
        , Mylangiser.ABI.Invariants
        , Mylangiser.ABI.FfiSeam
        , Mylangiser.ABI.Capstone

-- Totality is set here: Idris2 0.8.0 refuses --total as a command-line
-- override for package commands and then checks nothing.
opts = "--total"
